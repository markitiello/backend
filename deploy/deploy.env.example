# Configurazione del deploy: copiare in deploy/deploy.env (non va nel repository).

# Server via SSH: "utente@host". "local" = deploy su questa stessa macchina.
DEPLOY_HOST=deploy@api.benzina.example
# Porta SSH (facoltativa: se assente vale ~/.ssh/config o 22).
# DEPLOY_PORT=22
# Cartella base sul server. Il web server deve servire  $DEPLOY_PATH/current/public
DEPLOY_PATH=/var/www/benzina
# URL pubblico dell'API, per il controllo dopo il deploy (GET /health).
DEPLOY_URL=https://api.benzina.example
# Eseguibile PHP sul server (8.2 o successivo).
DEPLOY_PHP=php
# Quante versioni tenere per il rollback.
DEPLOY_KEEP=5
# Comando facoltativo dopo il cambio di versione, es. per svuotare OPcache:
# DEPLOY_RELOAD="sudo systemctl reload php8.4-fpm"
DEPLOY_RELOAD=

# --- Solo per deploy/deploy-ftp.sh (hosting condiviso senza SSH) -------------
FTP_HOST=ftp.benzina.example
FTP_USER=utente
# Password: meglio nella variabile d'ambiente FTP_PASSWORD che in questo file.
FTP_PASSWORD=
# Cartella remota del progetto (la cartella pubblica del dominio deve essere
# FTP_PATH/public, oppure FTP_PATH stessa grazie al .htaccess nella radice).
FTP_PATH=/benzina
