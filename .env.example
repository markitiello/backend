# Copiare in .env (sviluppo o hosting). Le variabili d'ambiente hanno la precedenza.

# Database (DSN PDO): SQLite, PostgreSQL o MySQL/MariaDB.
BENZINA_DB_DSN=sqlite:var/benzina.db
# BENZINA_DB_DSN=pgsql:host=localhost;dbname=benzina
# BENZINA_DB_DSN=mysql:host=localhost;dbname=benzina;charset=utf8mb4
# BENZINA_DB_USER=
# BENZINA_DB_PASSWORD=

# Accesso: almeno uno dei due (vedi docs/API.md, "Autenticazione").
BENZINA_API_KEYS=chiave-sviluppo
# BENZINA_APPCHECK_PROJECT_NUMBER=123456789012
# BENZINA_APPCHECK_APP_IDS=1:123456789012:android:abc123,1:123456789012:ios:def456

# Recensioni Google (facoltativo).
# BENZINA_GOOGLE_PLACES_API_KEY=
