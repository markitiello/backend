# Copiare in .env per lo sviluppo locale.
BENZINA_DATABASE_URL=sqlite:///./benzina.db

# Accesso: almeno uno dei due (vedi docs/API.md, "Autenticazione").
BENZINA_API_KEYS=chiave-sviluppo
# BENZINA_APPCHECK_PROJECT_NUMBER=123456789012
# BENZINA_APPCHECK_APP_IDS=1:123456789012:android:abc123,1:123456789012:ios:def456

# Recensioni Google (facoltativo).
# BENZINA_GOOGLE_PLACES_API_KEY=
