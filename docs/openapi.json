{
  "openapi": "3.1.0",
  "info": {
    "title": "Benzina API",
    "description": "\nAPI dell'app **Benzina**: distributori vicini con il prezzo più basso, media\nnazionale e andamento dei prezzi dei carburanti in Italia.\n\nI prezzi sono gli open data del MIMIT (Osservaprezzi Carburanti), aggiornati una\nvolta al giorno; valutazioni e recensioni vengono da Google Places.\n\n**Accesso**: tutte le rotte `/v1` richiedono l'header `X-Firebase-AppCheck`\n(token Firebase App Check dell'app) oppure `X-API-Key`. Vedi `docs/API.md`.\n",
    "license": {
      "name": "Dati prezzi: MIMIT, licenza IODL 2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Servizio"
        ],
        "summary": "Stato del servizio",
        "description": "Non richiede autenticazione. `data_date` è il giorno dell'ultimo import MIMIT.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stations/nearby": {
      "get": {
        "tags": [
          "Distributori"
        ],
        "summary": "Distributori vicini, dal più economico",
        "description": "Distributori entro `radius_km` che vendono `fuel`, con il prezzo dell'ultimo\naggiornamento MIMIT e la media nazionale per il confronto.",
        "operationId": "stations_nearby_v1_stations_nearby_get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitudine (WGS84).",
              "examples": [
                45.4781
              ],
              "title": "Lat"
            },
            "description": "Latitudine (WGS84)."
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitudine (WGS84).",
              "examples": [
                9.227
              ],
              "title": "Lng"
            },
            "description": "Longitudine (WGS84)."
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 50,
              "exclusiveMinimum": 0,
              "description": "Raggio di ricerca in km.",
              "default": 5,
              "title": "Radius Km"
            },
            "description": "Raggio di ricerca in km."
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Fuel",
              "description": "Carburante.",
              "default": "benzina"
            },
            "description": "Carburante."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Mode",
              "description": "`self` o `servito`. Ignorato per GPL e metano (si usa `any`).",
              "default": "self"
            },
            "description": "`self` o `servito`. Ignorato per GPL e metano (si usa `any`)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Numero massimo di risultati.",
              "default": 50,
              "title": "Limit"
            },
            "description": "Numero massimo di risultati."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non autorizzato"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parametri non validi"
          }
        }
      }
    },
    "/v1/stations": {
      "get": {
        "tags": [
          "Distributori"
        ],
        "summary": "Più distributori per id",
        "description": "Gli id che non esistono (es. distributori chiusi) vengono omessi.",
        "operationId": "stations_list_v1_stations_get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d+(,\\d+){0,49}$",
              "description": "Fino a 50 id separati da virgola (es. i preferiti).",
              "examples": [
                "3464,3468"
              ],
              "title": "Ids"
            },
            "description": "Fino a 50 id separati da virgola (es. i preferiti)."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationList"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non autorizzato"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parametri non validi"
          }
        }
      }
    },
    "/v1/stations/{station_id}": {
      "get": {
        "tags": [
          "Distributori"
        ],
        "summary": "Dettaglio di un distributore",
        "operationId": "station_detail_v1_stations__station_id__get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "`idImpianto` del MIMIT.",
              "examples": [
                3464
              ],
              "title": "Station Id"
            },
            "description": "`idImpianto` del MIMIT."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non autorizzato"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parametri non validi"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non trovato"
          }
        }
      }
    },
    "/v1/stations/{station_id}/trend": {
      "get": {
        "tags": [
          "Andamento prezzi"
        ],
        "summary": "Storico prezzi di un distributore",
        "description": "Prezzo a fine giornata. Mancano i giorni prima del primo prezzo noto.",
        "operationId": "station_trend_v1_stations__station_id__trend_get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "`idImpianto` del MIMIT.",
              "examples": [
                3464
              ],
              "title": "Station Id"
            },
            "description": "`idImpianto` del MIMIT."
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Fuel",
              "description": "Carburante.",
              "default": "benzina"
            },
            "description": "Carburante."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Mode",
              "description": "`self` o `servito`. Ignorato per GPL e metano (si usa `any`).",
              "default": "self"
            },
            "description": "`self` o `servito`. Ignorato per GPL e metano (si usa `any`)."
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 366,
              "minimum": 2,
              "description": "Numero di giorni, oggi incluso.",
              "default": 30,
              "title": "Days"
            },
            "description": "Numero di giorni, oggi incluso."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trend"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non autorizzato"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parametri non validi"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non trovato"
          }
        }
      }
    },
    "/v1/stations/{station_id}/google-rating": {
      "get": {
        "tags": [
          "Distributori"
        ],
        "summary": "Valutazione e recensioni Google",
        "description": "Dati di Google Places. Nell'app vanno mostrati con il testo di `attribution`\ne con il nome (e link) dell'autore di ogni recensione.\n\n- 404: distributore inesistente o nessun luogo Google abbinato.\n- 503: integrazione Google non configurata sul server.",
        "operationId": "station_google_rating_v1_stations__station_id__google_rating_get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "`idImpianto` del MIMIT.",
              "examples": [
                3464
              ],
              "title": "Station Id"
            },
            "description": "`idImpianto` del MIMIT."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoogleRating"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non autorizzato"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Parametri non validi"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Non trovato"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Servizio esterno non disponibile"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Servizio non disponibile"
          }
        }
      }
    },
    "/v1/trends/national": {
      "get": {
        "tags": [
          "Andamento prezzi"
        ],
        "summary": "Media nazionale giornaliera",
        "description": "Media dei prezzi di tutti i distributori d'Italia, un punto per giorno di\nimport. Esclusi i prezzi comunicati da oltre 30 giorni e i valori anomali.",
        "operationId": "trend_national_v1_trends_national_get",
        "security": [
          {
            "AppCheck": []
          },
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Fuel",
              "description": "Carburante.",
              "default": "benzina"
            },
            "description": "Carburante."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Mode",
              "description": "`self` o `servito`. Ignorato per GPL e metano (si usa `any`).",
              "default": "self"
