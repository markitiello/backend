  "components": {
    "schemas": {
      "Fuel": {
        "type": "string",
        "enum": [
          "benzina",
          "diesel",
          "gpl",
          "metano"
        ],
        "title": "Fuel"
      },
      "GoogleRating": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "examples": [
              4.3
            ]
          },
          "rating_count": {
            "type": "integer",
            "title": "Rating Count",
            "examples": [
              212
            ]
          },
          "maps_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maps Url",
            "description": "Pagina del luogo su Google Maps."
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/Review"
            },
            "type": "array",
            "title": "Reviews",
            "description": "Al massimo 5, scelte da Google."
          },
          "attribution": {
            "type": "string",
            "title": "Attribution",
            "description": "Testo di attribuzione obbligatorio da mostrare nell'app.",
            "default": "Valutazioni e recensioni fornite da Google"
          }
        },
        "type": "object",
        "required": [
          "place_id",
          "rating",
          "rating_count",
          "maps_url",
          "reviews"
        ],
        "title": "GoogleRating"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "data_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Date"
          }
        },
        "type": "object",
        "required": [
          "data_date"
        ],
        "title": "Health"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "self",
          "servito",
          "any"
        ],
        "title": "Mode"
      },
      "NearbyResponse": {
        "properties": {
          "fuel": {
            "$ref": "#/components/schemas/Fuel"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "description": "Modalità effettiva: `any` per GPL e metano."
          },
          "data_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Date",
            "description": "Giorno dell'ultimo aggiornamento MIMIT."
          },
          "national_average": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "National Average",
            "description": "Media nazionale dello stesso giorno."
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers",
            "description": "Dal più economico; a parità di prezzo il più vicino."
          }
        },
        "type": "object",
        "required": [
          "fuel",
          "mode",
          "data_date",
          "national_average",
          "offers"
        ],
        "title": "NearbyResponse"
      },
      "Offer": {
        "properties": {
          "station": {
            "$ref": "#/components/schemas/StationSummary"
          },
          "price": {
            "type": "number",
            "title": "Price",
            "examples": [
              1.739
            ]
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "reported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Reported At"
          },
          "distance_km": {
            "type": "number",
            "title": "Distance Km",
            "examples": [
              1.2
            ]
          }
        },
        "type": "object",
        "required": [
          "station",
          "price",
          "mode",
          "reported_at",
          "distance_km"
        ],
        "title": "Offer"
      },
      "Price": {
        "properties": {
          "fuel": {
            "$ref": "#/components/schemas/Fuel"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "description": "`self` o `servito`."
          },
          "price": {
            "type": "number",
            "title": "Price",
            "description": "€/l (€/kg per il metano).",
            "examples": [
              1.739
            ]
          },
          "reported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Reported At",
            "description": "Quando il gestore ha comunicato il prezzo."
          }
        },
        "type": "object",
