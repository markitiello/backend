<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per IIS (Windows, es. Plesk) quando il dominio punta alla cartella del
  progetto e non a public/: equivale al .htaccess nella stessa cartella.
  Ogni richiesta va a public/index.php; .env, src, var, vendor e il resto non
  sono mai raggiungibili. Richiede il modulo URL Rewrite di IIS (presente su
  Plesk).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Benzina" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="public/index.php" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment="bin" />
          <add segment="deploy" />
          <add segment="src" />
          <add segment="var" />
          <add segment="vendor" />
          <add segment="composer.json" />
          <add segment="composer.lock" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Mostra gli errori dell'app (JSON) invece della pagina di errore di IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
